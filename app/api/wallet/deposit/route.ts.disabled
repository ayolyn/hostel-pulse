import { NextResponse } from 'next/server';
import { createClient } from '@/lib/supabase/server';
import { createClient as createAdminClient } from '@supabase/supabase-js';
import { createNotification } from '@/lib/notifications';
export async function POST(req: Request) {
    try {
        const { amount } = await req.json();
        
        if (!amount || amount <= 0) {
            return NextResponse.json({ error: "Invalid amount." }, { status: 400 });
        }

        const supabase = await createClient();

        // 1. Authenticate user
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) {
            return NextResponse.json({ error: "Unauthorized" }, { status: 401 });
        }

        // 2. Admin Execution for Deposit & Notification
        const supabaseAdmin = createAdminClient(
            process.env.NEXT_PUBLIC_SUPABASE_URL!,
            process.env.SUPABASE_SERVICE_ROLE_KEY!
        );

        // Fetch current wallet balance
        const { data: profile, error: fetchError } = await supabaseAdmin
            .from('profiles')
            .select('wallet_balance')
            .eq('id', user.id)
            .single();

        if (fetchError) throw fetchError;

        const currentBalance = Number(profile.wallet_balance || 0);
        const newBalance = currentBalance + Number(amount);

        // Update balance
        const { error: updateError } = await supabaseAdmin
            .from('profiles')
            .update({ wallet_balance: newBalance })
            .eq('id', user.id);

        if (updateError) throw updateError;

        // Add Deposit Receipt
        const { error: depError } = await supabaseAdmin.from('deposits').insert({
            user_id: user.id,
            amount: Number(amount),
            status: 'completed'
        });

        if (depError) {
            console.error('Deposit Insert Error:', depError);
            throw depError;
        }

        // Add Notification
        await createNotification(
            user.id,
            'Deposit Successful',
            `Your deposit of ₦${Number(amount).toLocaleString()} was successful.`,
            '/dashboard/student?tab=wallet',
            'deposit'
        );

        return NextResponse.json({ success: true, newBalance });

    } catch (error: any) {
        console.error('Deposit API error:', error);
        return NextResponse.json({ error: error.message || "An unexpected error occurred." }, { status: 500 });
    }
}
